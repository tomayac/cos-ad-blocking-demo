{
  "manifest_version": 3,
  "name": "COS Ad Blocker (demo)",
  "description": "Shows what an extension can do with Cross-Origin Storage: list, delete, block by URL and by hash, clear site data, and use the DevTools protocol.",
  "version": "1.0",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webRequest",
    "storage",
    "crossOriginStorage",
    "browsingData",
    "debugger",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "COS Ad Blocker",
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_by_url",
        "enabled": true,
        "path": "rules/url.json"
      },
      {
        "id": "block_by_hash",
        "enabled": true,
        "path": "rules/hash.json"
      }
    ]
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  }
}
